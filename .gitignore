# Local, per-repo workflow artifacts scaffolded by /wf:init in consuming repos
_local/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# wf plugin
wf.config.js
.tmp/
docs/wf-plans/

# wf run evidence (WF-490): the resolver-issued phase-completion receipts and gate-approval
# records. The class is resolver-lifecycle-owned and project-scoped — its AUTHORITY model is
# the committed-lifecycle one, and that is unchanged here — but its CONTENT is per-run machine
# output, regenerated by every run and divergent across concurrent worktrees. Tracking it is
# each project's own choice; this repository, which generates it on every one of its own runs,
# does not. The machine-local issuer binding needs no entry: it lives in the machine-local
# home OUTSIDE the workspace (keyed per worktree root), never inside any checkout, which is
# exactly why it is there — a key inside the workspace would be one read away from a forgery.
.wf/run-evidence/

# wf-sandbox-testing: raw per-run experiment output — transcripts, workspace snapshots,
# and measure artifacts, hundreds of MB per experiment. Only the per-run SUBDIRECTORIES are
# ignored, so curated result markdown written directly into results/ (deltas.md,
# verdict-template.md) stays tracked.
plugins/wf-sandbox-testing/experiments/*/results/*/
