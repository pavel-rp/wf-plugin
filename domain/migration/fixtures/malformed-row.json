{
  "stack": {
    "source-root": "src/Legacy.Web",
    "target-root": "src/app",
    "source-exts": [".cs", ".cshtml"],
    "target-exts": [".ts", ".html", ".scss"]
  },
  "type-map": [
    { "source-type": "int", "target-type": "number" },
    { "target-type": "string" }
  ],
  "invariants": [
    { "id": "names-preserved", "statement": "Property names are preserved under the casing rule." }
  ],
  "rule-checks": [
    { "id": "rc-names", "asserts": "names-preserved", "check": "Each target property name maps 1:1 to its source name.", "severity": "fail" }
  ]
}
