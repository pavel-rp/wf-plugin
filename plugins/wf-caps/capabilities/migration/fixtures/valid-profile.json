{
  "stack": {
    "source-root": "src/Legacy.Web",
    "target-root": "src/app",
    "source-exts": [".cs", ".cshtml"],
    "target-exts": [".ts", ".html", ".scss"]
  },
  "type-map": [
    { "source-type": "int", "target-type": "number" },
    { "source-type": "string", "target-type": "string", "nullable": true },
    { "source-type": "List<T>", "target-type": "T[]", "note": "collection round-trip preserves order" }
  ],
  "invariants": [
    { "id": "names-preserved", "statement": "Property names are preserved under the casing rule.", "parity-relevant": true },
    { "id": "enum-roundtrip", "statement": "Enum integer values round-trip.", "parity-relevant": true }
  ],
  "rule-checks": [
    { "id": "rc-names", "asserts": "names-preserved", "check": "Each target property name maps 1:1 to its source name.", "severity": "fail" },
    { "id": "rc-ids", "asserts": "names-preserved", "check": "DOM ids/classes are preserved verbatim.", "severity": "warn" }
  ],
  "playbooks": [
    { "id": "pb-controller", "path": "plugins/wf-caps/capabilities/migration/fixtures/playbooks/port-controller.md", "applies-when": "task touches a controller" }
  ],
  "extraction-overrides": [
    { "match": "*.cshtml", "path": "plugins/wf-caps/capabilities/migration/fixtures/overrides/razor-grammar.md" }
  ]
}
