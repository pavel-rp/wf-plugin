    {
      "id": "audit_lens_boots",
      "kind": "record_match",
      "description": "all audit-lens boots \u2014 dispatch records naming an audit lens",
      "record": {
        "type": "system",
        "subtype": "task_started"
      },
      "match": [
        {
          "field": "subagent_type",
          "op": "prefix",
          "value": "wf-audit:"
        }
      ]
    },
    {
      "id": "gated_off_lens_boots",
      "kind": "record_match",
      "description": "audit-lens boots whose own record identifies the boot as gated off",
      "record": {
        "type": "system",
        "subtype": "task_started"
      },
      "match": [
        {
          "field": "subagent_type",
          "op": "prefix",
          "value": "wf-audit:"
        },
        {
          "field": "",
          "op": "contains",
          "value": [
            "gated-off",
            "gated off"
          ]
        }
      ]
    },
    {
      "id": "index_dispatch",
      "kind": "dispatch_shape",
      "description": "per-task index child dispatches (absent means the index write is inline)",
      "subagent_type": "wf:index"
    },
    {
      "id": "dispatch_model_tier",
      "kind": "record_match",
      "description": "dispatch records pinning a top-tier model \u2014 the routing tier assertion",
      "record": {
        "type": "system",
        "subtype": "task_started"
      },
      "match": [
        {
          "field": "model",
          "op": "contains",
          "value": "opus"
        }
      ]
    }
